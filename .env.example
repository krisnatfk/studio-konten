# ===== Telegram =====
# Token dari @BotFather
TELEGRAM_BOT_TOKEN=
# User ID yang boleh memakai bot (pisahkan koma). Kosongkan dulu: bot akan membalas ID kamu.
TELEGRAM_ALLOWED_USERS=
# Server Bot API. Ganti ke http://127.0.0.1:8081 + TELEGRAM_LOCAL_API=true bila memakai telegram-bot-api lokal (file >50 MB)
TELEGRAM_API_URL=https://api.telegram.org
TELEGRAM_LOCAL_API=false

# ===== LLM: vLLM yang SUDAH berjalan (Gemma 4) =====
# Cek nama model:  curl http://127.0.0.1:8000/v1/models
LLM_ENABLED=true
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=QuantTrio/gemma-4-31B-it-AWQ
LLM_API_KEY=EMPTY
LLM_TIMEOUT=240
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=4000
# Matikan mode "thinking" lewat chat_template_kwargs (diabaikan bila tidak didukung)
LLM_DISABLE_THINKING=true
# Gateway seperti Combo GG: effort diterapkan pada analisis, sutradara, dan review vision.
# LLM_DISABLE_THINKING hanya berlaku untuk vLLM lokal.
LLM_REASONING_EFFORT=high
# Ruang reasoning tambahan di luar target jawaban; LLM_MAX_TOKENS membatasi total keduanya.
LLM_REASONING_TOKENS=8000

# ===== Whisper (transkripsi, opsional) =====
# auto = GPU bila VRAM kosong >= WHISPER_MIN_FREE_MB, selain itu CPU | cuda | cpu | off
WHISPER_MODE=auto
WHISPER_MODEL=large-v3-turbo
WHISPER_MIN_FREE_MB=2600
WHISPER_CPU_THREADS=8
# Tetap transkrip walau naskah dikirim (timing lebih presisi). false = pakai deteksi jeda saja.
WHISPER_WHEN_SCRIPT=true

# ===== Render =====
RENDER_FPS=30
# 0 = otomatis (setengah jumlah core CPU, maks 10)
RENDER_WORKERS=0
JPEG_QUALITY=92
X264_PRESET=veryfast
X264_CRF=19
# Batas ukuran video agar bisa dikirim bot Telegram resmi (50 MB). 0 = tanpa batas (pakai bila Bot API lokal)
MAX_VIDEO_MB=48
# Kosongkan untuk Chromium bawaan Playwright
CHROME_PATH=
KEEP_FRAMES=false

# ===== Konten =====
DEFAULT_STYLE=horor_kampung
WATERMARK=
SHOW_TITLE_BAR=true

# ===== Dashboard web =====
WEB_HOST=0.0.0.0
WEB_PORT=8090
# Isi untuk mengunci dashboard (login: user bebas, password ini)
WEB_PASSWORD=
